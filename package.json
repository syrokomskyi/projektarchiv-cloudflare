{
  "name": "@warpgogol/projektarchiv-cloudflare",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Cloudflare storage and coordination adapters for Projektarchiv.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./coordinator": {
      "types": "./src/coordinator/index.ts",
      "default": "./src/coordinator/index.ts"
    },
    "./artifact-store": {
      "types": "./src/artifact-store/index.ts",
      "default": "./src/artifact-store/index.ts"
    },
    "./catalog-store": {
      "types": "./src/catalog-store/index.ts",
      "default": "./src/catalog-store/index.ts"
    },
    "./recovery": {
      "types": "./src/recovery/index.ts",
      "default": "./src/recovery/index.ts"
    },
    "./capture": { "types": "./src/capture/index.ts", "default": "./src/capture/index.ts" },
    "./knowledge": { "types": "./src/knowledge/index.ts", "default": "./src/knowledge/index.ts" },
    "./erasure": { "types": "./src/erasure/index.ts", "default": "./src/erasure/index.ts" }
  },
  "files": [
    "dist/",
    "src/index.ts",
    "src/artifact-store/",
    "src/catalog-store/",
    "src/coordinator/",
    "src/recovery/",
    "src/capture/",
    "src/knowledge/",
    "src/erasure/",
    "src/erasure/",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit",
    "check": "pnpm run build:check && pnpm run test",
    "lint": "pnpm exec eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@warpgogol/projektarchiv-core": "workspace:*",
    "@warpgogol/projektarchiv-operations": "workspace:*",
    "icebird": "0.8.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^26.2.0",
    "fast-check": "^4.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
